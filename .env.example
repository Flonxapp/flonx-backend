# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=3500
BASE_URL=0.0.0.0
DOMAIN=https://flonxapp.com
DATABASE_URL=

# comma separated, used by the API and socket.io
CORS_ORIGINS=https://flonxapp.com,https://admin.flonxapp.com,https://venue.flonxapp.com
# proxies in front of the app (nginx = 1)
TRUST_PROXY=1

BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
RESET_PASSWORD_UI_LINK=

# rate limits
RATE_LIMIT_PER_MINUTE=300
LOGIN_LIMIT_PER_15_MIN=10
OTP_LIMIT_PER_15_MIN=10

# guests must send their guestSecret on later logins
GUEST_SECRET_ENFORCED=true

# orders and wallet
MAX_CONCURRENT_ORDERS=40
PENDING_ORDER_TTL_MINUTES=30
PLATFORM_FEE_PERCENTAGE=10
TIP_PLATFORM_FEE_PERCENTAGE=0
MIN_WITHDRAW_AMOUNT=10
CONNECTED_ACCOUNT_PAYOUT_INTERVAL=daily

# Stripe
STRIPE_SECRET_KEY=
WEBHOOK_ENDPOINT_SECRET=
WEBHOOK_ENDPOINT_SECRET_FOR_CONNECTED=
ONBOARDING_REFRESH_URL=
ONBOARDING_RETURN_URL=
STRIPE_ORDER_PAYMENT_SUCCESS_URL=
STRIPE_ORDER_PAYMENT_CANCEL_URL=
STRIPE_TIP_PAYMENT_SUCCESS_URL=
STRIPE_TIP_PAYMENT_CANCEL_URL=

# AWS S3 / CloudFront
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
CLOUDFRONT_URL=

# email
SMTP_HOST=
SMTP_PORT=
SMTP_SERVICE=
SMTP_MAIL=
SMTP_PASS=

# push notifications
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# social login
GOOGLE_CLIENT_ID=
WEB_CLIENT_ID=
APPLE_CLIENT_ID=
